{% extends 'base.html.twig' %}

{% block title %}Édition Équipe{% endblock %}

{% block body %}
    <header>
        <div id="current-user"></div>
        <div id="title-page">
            <h1>Édition Équipe</h1>
        </div>
    </header>

    <div id="content">
        {# On ajoute la classe form-main pour limiter la largeur comme sur la maquette #}
        <div class="card p-4" style="border:none; background: transparent;">

            {{ form_start(form, {'attr': {'class': 'form-main'}}) }}

            {# 1. Nom #}
            <div class="mb-3">
                {{ form_label(form.lastName) }}
                {{ form_widget(form.lastName) }}
                <div class="text-danger small">{{ form_errors(form.lastName) }}</div>
            </div>

            {# 2. Prénom #}
            <div class="mb-3">
                {{ form_label(form.firstName) }}
                {{ form_widget(form.firstName) }}
                <div class="text-danger small">{{ form_errors(form.firstName) }}</div>
            </div>

            {# 3. Email #}
            <div class="mb-3">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                <div class="text-danger small">{{ form_errors(form.email) }}</div>
            </div>

            {# 4. Ligne Date et Statut (2 colonnes) #}
            <div class="form-flex">
                <div>
                    {{ form_label(form.startDate) }}
                    {{ form_widget(form.startDate) }}
                    <div class="text-danger small">{{ form_errors(form.startDate) }}</div>
                </div>
                <div>
                    {{ form_label(form.status) }}
                    {{ form_widget(form.status) }}
                    <div class="text-danger small">{{ form_errors(form.status) }}</div>
                </div>
            </div>

            {# 5. Rôle #}
            <div class="mb-3">
                {{ form_label(form.roles) }}
                {# Petite astuce : on ajoute un style pour la hauteur si c'est un select multiple #}
                {{ form_widget(form.roles, {'attr': {'style': 'height: auto; min-height: 50px;'}}) }}
                <div class="text-danger small">{{ form_errors(form.roles) }}</div>
                <small class="text-muted">Maintenez Ctrl (ou Cmd) pour sélectionner plusieurs rôles.</small>
            </div>

            {# 6. Bouton Enregistrer #}
            <button class="button button-submit">
                {{ button_label|default('Enregistrer') }}
            </button>

            <div class="mt-3 text-center">
                <a href="{{ path('app_user_index') }}" style="text-decoration: underline; color: #5C5C5C;">Annuler</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
