{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{% block title %}TaskLinker{% endblock %}</title>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

</head>
<body>
<div id="main-container">
    <nav>
        <a href="{{ path('app_home') }}" id="logo">
            <img src="{{ asset('img/logo.png') }}" alt="Logo TaskLinker" />
        </a>

        {# On récupère le nom de la route actuelle (ex: 'app_home', 'project_show', 'team_index') #}
        {% set currentRoute = app.request.attributes.get('_route') %}

        <ul id="main-menu">
            {# Lien Projets (Accessible à tous les connectés) #}
            <li class="{{ (currentRoute == 'app_home' or currentRoute starts with 'project_' or currentRoute starts with 'task_') ? 'active' : '' }}">
                <a href="{{ path('app_home') }}">
                    <i class="fa-solid fa-list-check"></i> Projets
                </a>
            </li>

            {# Lien Équipe (Sécurisé : Admin seulement) #}
            {% if is_granted('ROLE_PROJECT_MANAGER') %}
                {# On vérifie si la route commence par 'app_user_' pour mettre la classe active #}
                <li class="{{ (currentRoute starts with 'app_user_') ? 'active' : '' }}">
                    <a href="{{ path('app_user_index') }}">
                        <i class="fa-regular fa-user"></i> Équipe
                    </a>
                </li>
            {% endif %}

            <li class="mt-auto">
                <a href="{{ path('app_logout') }}">
                    <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    {% if app.user %}
        <div class="user-header-profile">
            <div class="user-avatar">
                {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
            </div>
        </div>
    {% endif %}

    <main>
        {% block body %}{% endblock %}
    </main>
</div>

{% block javascripts %}
            {{ encore_entry_script_tags('app') }}
{% endblock %}
</body>
</html>
